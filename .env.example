# Canonical public origin; leave empty until a domain is approved.
NEXT_PUBLIC_SITE_URL=
# Set all three to enable delivery. From must be verified with Resend.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=
# Durable rate limiting (Upstash Redis REST). Required in production for delivery.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
